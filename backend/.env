# ============================================================================
# Traffic Core Backend - Environment Configuration
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# JWT Configuration
JWT_SECRET=traffic-core-secret-key-change-in-production-2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=traffic-core-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Hyperledger Fabric Configuration
FABRIC_CONNECT_ON_STARTUP=true
CHANNEL_NAME=traffic-channel
MSP_ID=Org1MSP

# Peer Configuration
PEER_ENDPOINT=localhost:7051
PEER_HOST_ALIAS=peer0.org1.traffic-network.com

# Crypto Path (adjust based on your network setup)
CRYPTO_PATH=/home/aya/traffic-core/network/organizations/peerOrganizations/org1.traffic-network.com

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting (relaxed for development)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=combined

# API Configuration
API_PREFIX=/api/v1
API_DOCS_ENABLED=true
