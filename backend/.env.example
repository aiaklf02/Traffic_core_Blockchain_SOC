# ============================================================================
# Configuration Backend - Smart City Traffic Management System
# ============================================================================
# Copiez ce fichier vers .env et modifiez les valeurs selon votre environnement
# ============================================================================

# ----------------------------------------------------------------------------
# Configuration du serveur
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=localhost

# ----------------------------------------------------------------------------
# Configuration JWT
# ----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_REFRESH_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# Configuration Hyperledger Fabric
# ----------------------------------------------------------------------------
# Nom du canal
CHANNEL_NAME=traffic-channel

# Noms des chaincodes
CHAINCODE_ROAD_MANAGER=road-manager
CHAINCODE_SENSOR_DATA=sensor-data
CHAINCODE_TRAFFIC_REGISTRY=traffic-registry

# MSP ID de l'organisation
MSP_ID=TrafficAuthorityMSP

# Chemin vers les certificats et clés
CRYPTO_PATH=../network/organizations/peerOrganizations/trafficauthority.traffic.com
CERT_PATH=${CRYPTO_PATH}/users/User1@trafficauthority.traffic.com/msp/signcerts/cert.pem
KEY_PATH=${CRYPTO_PATH}/users/User1@trafficauthority.traffic.com/msp/keystore/
TLS_CERT_PATH=${CRYPTO_PATH}/peers/peer0.trafficauthority.traffic.com/tls/ca.crt

# Configuration du peer
PEER_ENDPOINT=localhost:7051
PEER_HOST_ALIAS=peer0.trafficauthority.traffic.com

# Configuration de l'orderer
ORDERER_ENDPOINT=localhost:7050
ORDERER_HOST_ALIAS=orderer1.traffic.com

# ----------------------------------------------------------------------------
# Configuration CORS
# ----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_CREDENTIALS=true

# ----------------------------------------------------------------------------
# Configuration Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------------------------------------------
# Configuration Logging
# ----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=combined
LOG_DIR=./logs

# ----------------------------------------------------------------------------
# Configuration API
# ----------------------------------------------------------------------------
API_PREFIX=/api/v1
API_DOCS_ENABLED=true
API_DOCS_PATH=/api-docs

# ----------------------------------------------------------------------------
# Configuration Base de données (optionnel - pour cache/sessions)
# ----------------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# Configuration Monitoring (optionnel)
# ----------------------------------------------------------------------------
# PROMETHEUS_ENABLED=false
# PROMETHEUS_PORT=9090
